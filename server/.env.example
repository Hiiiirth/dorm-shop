# 复制为 .env 后按需修改
# PowerShell:  Copy-Item .env.example .env
# Git Bash:    cp .env.example .env

# ---- 服务 ----
PORT=3000
NODE_ENV=development
# 全局接口前缀，统一响应规范挂在这个前缀下
API_PREFIX=api/v1

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ⚠️ 换成你本机 MySQL 的真实密码。这个文件是会提交到仓库的，别把真密码写进来。
DB_PASSWORD=your_mysql_password
DB_DATABASE=dorm_shop
# 开发期自动同步表结构，生产必须为 false（用 db/01-schema.sql 建表）
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---- JWT ----
# ⚠️ 生产环境务必替换成随机长字符串（例如 `openssl rand -hex 32` 的输出）。
#    用默认值等于没有签名保护，任何人都能自己签一个 admin token。
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d

# ---- 微信小程序 ----
# 没有微信 appid 时留空，并把下面置 true 走 mock 登录
WX_APPID=
WX_SECRET=
# 本地开发没有微信 appid 时置 true，登录走 mock openid，方便自测。
# ⚠️ 生产环境必须为 false。
WX_MOCK_LOGIN=true

# ---- Redis（二期） ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
